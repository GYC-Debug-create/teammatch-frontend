/* pages/email-verify/email-verify.wxss */
page {
  min-height: 100vh;
  background: linear-gradient(180deg, #ffffff 0%, #f7f9ff 100%);
  color: #09244b;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.verify-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 56rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
}

/* 头部 Hero 区域 - 优化间距与字号 */
.hero {
  margin-bottom: 44rpx;
}

.eyebrow {
  color: rgba(9, 36, 75, 0.52);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 34rpx;
  letter-spacing: 0.5rpx; /* 稍微增加字间距，更清晰 */
}

.title {
  margin-top: 16rpx;          /* 稍微增大与eyebrow的间距 */
  color: #000000;
  font-size: 46rpx;           /* 从 50rpx 降到 46rpx，减小过大感 */
  font-weight: 900;
  line-height: 64rpx;         /* 从 68rpx 降到 64rpx，更紧凑 */
}

.desc {
  margin-top: 12rpx;          /* 增大与标题的间距 */
  color: rgba(0, 0, 0, 0.58);
  font-size: 26rpx;
  font-weight: 500;           /* 增加字重，让说明更清晰 */
  line-height: 38rpx;
}

/* 表单卡片 */
.form-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.form-item {
  margin-bottom: 36rpx;
}

.form-label {
  display: block;
  margin-bottom: 12rpx;
  color: #111111;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.form-input {
  border: 1rpx solid #e7edfb;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  background: #f8faff;
  color: #111;
}

.code-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.code-input {
  flex: 1;
}

.send-code-btn {
  width: 200rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: #e7edfb;
  color: #2f54eb;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
  padding: 0;
}

.send-code-btn.disabled {
  background: #f0f0f0;
  color: #999;
}

.code-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(0,0,0,0.4);
}

/* 错误信息 */
.error-msg {
  margin-bottom: 24rpx;
  padding: 16rpx 24rpx;
  background: #fff0f0;
  border-radius: 16rpx;
  color: #d32f2f;
  font-size: 24rpx;
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #2f54eb;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 24rpx;
  margin-top: 20rpx;
  border: none;
}

.submit-btn[disabled] {
  background: #ccc;
  color: #999;
}