<!--pages/email-verify/email-verify.wxml-->
<view class="page-bg">
  <view class="verify-page">
    <!-- 头部 Hero 区域 - 优化版 -->
    <view class="hero">
      <text class="eyebrow">TeamMatch · 身份认证</text>
      <text class="title">绑定学校邮箱</text>
      <text class="desc">完成邮箱验证后方可建立正式档案，解锁全部功能。</text>
    </view>

    <!-- 表单卡片 -->
    <view class="form-card">
      <!-- 邮箱输入 -->
      <view class="form-item">
        <text class="form-label">学校邮箱</text>
        <input class="form-input" type="text" placeholder="请输入学校邮箱，如 user-86fc814a@example.invalid" value="{{email}}" bindinput="onEmailInput"/>
      </view>

      <!-- 验证码区域 -->
      <view class="form-item">
        <text class="form-label">验证码</text>
        <view class="code-row">
          <input class="form-input code-input" type="number" placeholder="请输入验证码" value="{{code}}" bindinput="onCodeInput" maxlength="6"/>
          <button class="send-code-btn {{countdown > 0 ? 'disabled' : ''}}" bindtap="sendCode" loading="{{sendingCode}}" disabled="{{countdown > 0 || sendingCode}}">
            {{countdown > 0 ? countdown + 's' : '发送验证码'}}
          </button>
        </view>
        <text class="code-hint">Mock 验证: 输入 654321 可验证成功</text>
      </view>

      <!-- 错误信息 -->
      <view class="error-msg" wx:if="{{errorMsg}}">{{errorMsg}}</view>

      <!-- 提交按钮 -->
      <button class="submit-btn" type="primary" bindtap="verifyCode" loading="{{verifying}}" disabled="{{verifying}}">
        验证邮箱
      </button>
    </view>
  </view>
</view>