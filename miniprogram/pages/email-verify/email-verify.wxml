<!--pages/email-verify/email-verify.wxml-->
<view class="page">
  <!-- 固定头部区 -->
  <view class="page-sticky">
    <view class="hd">
      <text class="hd-sub">TeamMatch · Auth</text>
      <text class="hd-title">绑定学校邮箱</text>
      <text class="hd-desc">完成邮箱验证后方可解锁全部功能</text>
    </view>
  </view>

  <!-- 内容可滑动区 -->
  <scroll-view class="sv" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="card">
      <!-- 邮箱输入 -->
      <view class="form-item">
        <text class="form-label">学校邮箱</text>
        <input class="form-input" type="text" placeholder="请输入学校邮箱，如 user-86fc814a@example.invalid" placeholder-class="ph" value="{{email}}" bindinput="onEmailInput"/>
      </view>

      <!-- 验证码区域 -->
      <view class="form-item form-item-last">
        <text class="form-label">验证码</text>
        <view class="code-row">
          <input class="form-input code-input" type="number" placeholder="请输入验证码" placeholder-class="ph" value="{{code}}" bindinput="onCodeInput" maxlength="6"/>
          <button class="send-code-btn {{countdown > 0 ? 'disabled' : ''}}" bindtap="sendCode" loading="{{sendingCode}}" disabled="{{countdown > 0 || sendingCode}}">
            {{countdown > 0 ? countdown + 's' : '发送验证码'}}
          </button>
        </view>
        <text class="code-hint">Mock 验证: 输入 654321 可验证成功</text>
      </view>
    </view>

    <!-- 错误信息 -->
    <view class="err" wx:if="{{errorMsg}}">
      <text class="err-txt">{{errorMsg}}</text>
    </view>

    <!-- 提交按钮 -->
    <view class="btn-wrap">
      <button class="submit-btn" bindtap="verifyCode" loading="{{verifying}}" disabled="{{verifying}}">
        验证邮箱
      </button>
    </view>
  </scroll-view>
</view>