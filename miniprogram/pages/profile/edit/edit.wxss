/* pages/profile/edit.wxss */
.container { padding: 20px; background: #f5f5f5; min-height: 100vh; }
.form { background: #fff; border-radius: 10px; padding: 20px; }
.form-item { margin-bottom: 20px; }
.label { display: block; font-size: 16px; font-weight: bold; margin-bottom: 8px; color: #333; }
.input { border: 1px solid #ddd; border-radius: 6px; padding: 12px; font-size: 14px; }
.textarea { border: 1px solid #ddd; border-radius: 6px; padding: 12px; font-size: 14px; height: 100px; }
.save-btn { margin-top: 30px; border-radius: 8px; }
.error-msg { color: #e74c3c; font-size: 14px; margin-top: 10px; text-align: center; }