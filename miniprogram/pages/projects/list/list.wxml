<!--pages/projects/list/list.wxml-->
<view class="container">
  <!-- 顶部搜索栏占位 -->
  <view class="search-bar">
    <view class="search-input">
      <text class="search-icon">🔍</text>
      <text class="search-placeholder">搜索项目...</text>
    </view>
  </view>

  <!-- 项目列表 -->
  <view class="project-list">
    <block wx:for="{{projects}}" wx:key="id">
      <view class="project-card" bindtap="goToDetail" data-id="{{item.id}}">
        <!-- 项目标题和状态 -->
        <view class="card-header">
          <text class="project-title">{{item.title}}</text>
          <text class="status-tag {{item.status}}">{{item.statusText}}</text>
        </view>

        <!-- 项目描述 -->
        <view class="card-desc">{{item.description}}</view>

        <!-- 板块和人数 -->
        <view class="card-info">
          <view class="info-item">
            <text class="info-icon">📂</text>
            <text class="info-text">{{item.boardName}}</text>
          </view>
          <view class="info-item">
            <text class="info-icon">👥</text>
            <text class="info-text">{{item.currentMembers}}/{{item.maxMembers}}人</text>
          </view>
        </view>

        <!-- 技能标签 -->
        <view class="skill-tags">
          <text class="skill-tag" wx:for="{{item.skills}}" wx:key="*this" wx:for-item="skill">{{skill}}</text>
        </view>

        <!-- 底部信息 -->
        <view class="card-footer">
          <text class="creator">发布者：{{item.creatorName}}</text>
          <text class="deadline">截止：{{item.deadline}}</text>
        </view>
      </view>
    </block>
  </view>

  <!-- 加载状态 -->
  <view class="loading-more" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>