/* pages/projects/list/list.wxss */
.container {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 20px;
}

/* 搜索栏 */
.search-bar {
  padding: 15px;
  background: #fff;
}

.search-input {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 8px;
  padding: 10px 15px;
}

.search-icon {
  margin-right: 8px;
  font-size: 16px;
}

.search-placeholder {
  color: #999;
  font-size: 14px;
}

/* 项目卡片 */
.project-list {
  padding: 15px;
}

.project-card {
  background: #fff;
  border-radius: 12px;
  padding: 20px;
  margin-bottom: 15px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.04);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.project-title {
  font-size: 18px;
  font-weight: bold;
  color: #333;
  flex: 1;
  margin-right: 10px;
}

.status-tag {
  font-size: 12px;
  padding: 4px 10px;
  border-radius: 20px;
  white-space: nowrap;
}

.status-tag.recruiting {
  background: #e8f5e9;
  color: #2e7d32;
}

.status-tag.in_progress {
  background: #e3f2fd;
  color: #1565c0;
}

.status-tag.ended {
  background: #f5f5f5;
  color: #999;
}

.card-desc {
  font-size: 14px;
  color: #666;
  line-height: 1.6;
  margin-bottom: 12px;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.card-info {
  display: flex;
  margin-bottom: 12px;
}

.info-item {
  display: flex;
  align-items: center;
  margin-right: 20px;
}

.info-icon {
  font-size: 14px;
  margin-right: 4px;
}

.info-text {
  font-size: 13px;
  color: #888;
}

/* 技能标签 */
.skill-tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 12px;
}

.skill-tag {
  font-size: 12px;
  background: #f0f0f0;
  color: #555;
  padding: 4px 10px;
  border-radius: 4px;
  margin-right: 8px;
  margin-bottom: 6px;
}

/* 底部信息 */
.card-footer {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  color: #aaa;
  border-top: 1px solid #f0f0f0;
  padding-top: 10px;
}