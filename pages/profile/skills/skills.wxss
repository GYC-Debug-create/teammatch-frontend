/* pages/profile/skills/skills.wxss */
page {
  min-height: 100vh;
  background: linear-gradient(180deg, #ffffff 0%, #f7f9ff 100%);
  color: #09244b;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.skills-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 56rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
}

/* 头部 Hero 区域 */
.hero {
  margin-bottom: 44rpx;
}

.eyebrow {
  color: rgba(9, 36, 75, 0.52);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 34rpx;
  letter-spacing: 0.5rpx;
}

.title {
  margin-top: 16rpx;
  color: #000000;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 64rpx;
}

.desc {
  margin-top: 12rpx;
  color: rgba(0, 0, 0, 0.58);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 38rpx;
}

/* 已选区域卡片 */
.selected-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.card-label {
  display: block;
  margin-bottom: 16rpx;
  color: #111111;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.selected-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.selected-tag {
  display: flex;
  align-items: center;
  background: #2f54eb;
  color: #ffffff;
  padding: 8rpx 20rpx 8rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.tag-remove {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: rgba(255,255,255,0.8);
}

/* 分类卡片 */
.category-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

/* 标签网格 */
.tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.skill-tag {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  background: #f0f2ff;
  color: #2f54eb;
  font-size: 24rpx;
  font-weight: 500;
  border: 1rpx solid transparent;
}

.skill-tag.active {
  background: #2f54eb;
  color: #ffffff;
  border-color: #2f54eb;
}

.tag-check {
  margin-left: 6rpx;
  font-size: 20rpx;
}

/* 错误信息 */
.error-msg {
  margin-bottom: 24rpx;
  padding: 16rpx 24rpx;
  background: #fff0f0;
  border-radius: 16rpx;
  color: #d32f2f;
  font-size: 24rpx;
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #2f54eb;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 24rpx;
  margin-top: 20rpx;
  border: none;
}

.submit-btn[disabled] {
  background: #ccc;
  color: #999;
}