<view class="page">
  <!-- 固定头部区：吸顶不跟随滑动 -->
  <view class="page-sticky">
    <!-- 头部：复用 T-031 样式 -->
    <view class="page-header">
      <view class="page-header-top">
        <view class="page-header-top-left">
          <text class="page-header-sub">TeamMatch · T-032</text>
          <text class="page-header-title">项目成员</text>
          <text class="page-header-desc">管理你的团队</text>
        </view>
        <button class="back-hub-btn" bindtap="goFunctionHub">功能选择</button>
      </view>
    </view>

    <!-- 项目名称 -->
    <view class="project-badge">
      <view class="project-badge-icon">AI</view>
      <text class="project-badge-name">{{projectTitle}}</text>
    </view>
  </view>

  <!-- 可滑动成员列表 -->
  <scroll-view class="member-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- 成员列表 -->
    <view class="member-list" wx:if="{{members.length > 0}}">
      <view
        class="member-card"
        wx:for="{{members}}"
        wx:key="id"
      >
        <!-- 头像 -->
        <image class="member-avatar" src="{{item.avatar}}" mode="aspectFill" />

        <!-- 信息区 -->
        <view class="member-info">
          <view class="member-name-row">
            <text class="member-name">{{item.nickname}}</text>
            <!-- 队长标签：金色 LEADER -->
            <text class="role-tag leader" wx:if="{{item.role === 'leader'}}">LEADER</text>
          </view>
          <text class="member-major">{{item.major}}</text>

          <!-- 退出原因小字：仅 exited 状态显示 -->
          <text class="exit-reason" wx:if="{{item.status === 'exited'}}">
            {{item.exitMode === 'self_exit' ? '主动退出' : '被投票移除'}} · {{item.exitDate}}
          </text>
        </view>

        <!-- 右侧区 -->
        <view class="member-right">
          <!-- 状态标签 -->
          <text class="status-tag {{item.status === 'active' ? 'active' : 'exited'}}">
            {{item.status === 'active' ? 'ACTIVE' : 'EXITED'}}
          </text>

          <!-- 信任分 -->
          <text class="trust-score">Trust {{item.trustScore}}</text>

          <!-- 操作图标：队长对 active 成员显示 ... -->
          <image
            wx:if="{{currentUserId === 1 && item.role !== 'leader' && item.status === 'active'}}"
            class="action-icon"
            src="/images/icon-more.png"
            mode="aspectFit"
          />
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:else>
      <text>暂无其他成员</text>
    </view>
  </scroll-view>
</view>
