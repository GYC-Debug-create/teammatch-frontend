/* pages/projects/create/create.wxss */
/* 与 M2 风格保持一致的全局背景与字体 */
page {
  min-height: 100vh;
  background: linear-gradient(180deg, #ffffff 0%, #f7f9ff 100%);
  color: #09244b;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.create-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 56rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
}

/* 头部复用 M2 的 hero 样式 */
.hero {
  margin-bottom: 44rpx;
}

.eyebrow {
  color: rgba(9, 36, 75, 0.52);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.title {
  margin-top: 12rpx;
  color: #000000;
  font-size: 50rpx;
  font-weight: 900;
  line-height: 68rpx;
}

.desc {
  margin-top: 8rpx;
  color: rgba(0, 0, 0, 0.58);
  font-size: 26rpx;
  line-height: 38rpx;
}

/* 表单卡片，复用 M2 的卡片风格 */
.form-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.form-item {
  margin-bottom: 36rpx;
}

.form-label {
  display: block;
  margin-bottom: 12rpx;
  color: #111111;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.form-input {
  border: 1rpx solid #e7edfb;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  background: #f8faff;
  color: #111;
}

.form-textarea {
  border: 1rpx solid #e7edfb;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  background: #f8faff;
  color: #111;
  height: 160rpx;
  min-height: 160rpx;
}

.textarea-counter {
  text-align: right;
  font-size: 22rpx;
  color: rgba(0,0,0,0.4);
  margin-top: 8rpx;
}

.picker-view {
  border: 1rpx solid #e7edfb;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  background: #f8faff;
  color: #111;
  font-size: 26rpx;
}

/* 技能标签选择，参考 M2 的卡片内元素 */
.skill-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.skill-tag {
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  background: #f0f2ff;
  color: #2f54eb;
  font-size: 24rpx;
  font-weight: 500;
  border: 1rpx solid transparent;
  transition: all 0.2s;
}

.skill-tag.active {
  background: #2f54eb;
  color: #ffffff;
  border-color: #2f54eb;
}

/* 错误信息 */
.error-msg {
  margin-bottom: 24rpx;
  padding: 16rpx 24rpx;
  background: #fff0f0;
  border-radius: 16rpx;
  color: #d32f2f;
  font-size: 24rpx;
}

/* 提交按钮，使用 M2 的主色调 */
.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #2f54eb;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 24rpx;
  margin-top: 20rpx;
  border: none;
}

.submit-btn[disabled] {
  background: #ccc;
  color: #999;
}